
ARCJET_ENV=''
ARCJET_KEY=''
ARCJET_MODE=''
ARCJET_SITE_ID=''

# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Admin user created/promoted by `pnpm db:seed` (see DEVELOPMENT.md).
# ADMIN_PASSWORD is only needed the first time the admin is created.
ADMIN_EMAIL=''
ADMIN_NAME='Admin'
ADMIN_PASSWORD=''

# Better Auth
BETTER_AUTH_SECRET=''
BETTER_AUTH_URL=''